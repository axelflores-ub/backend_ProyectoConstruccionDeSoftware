# Copiar a .env y ajustar. NO commitear .env
# ------------------------------------------------------------------

# Django
DEBUG=True
SECRET_KEY=django-insecure-cambia-esta-clave-en-produccion
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos (PostgreSQL en Docker -> ver docker-compose.yml)
# Formato: postgres://USUARIO:PASSWORD@HOST:PUERTO/NOMBRE_DB
# Si tenés un PostgreSQL local ocupando el 5432: levantá Docker con
# DB_HOST_PORT=5433 y cambiá el puerto de esta URL a 5433.
DATABASE_URL=postgres://corralon:1234567890@localhost:5432/corralonDB

# CORS: orígenes del frontend permitidos (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT (minutos / días)
ACCESS_TOKEN_LIFETIME_MIN=60
REFRESH_TOKEN_LIFETIME_DAYS=7
