# Normaliza los finales de línea: en el repo siempre LF.
* text=auto eol=lf

# Scripts que DEBEN quedar en LF sí o sí
*.sh text eol=lf

# Scripts de PowerShell: CRLF en el working copy de Windows
*.ps1 text eol=crlf

# Binarios: que Git no los toque
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
